# Supabase — copy this file to `.env.local` and fill in your project's values.
# Both are PUBLIC client keys (safe to ship): the anon key is protected by
# Row-Level Security. NEVER put the service_role key in here or anywhere the
# client can read it.
#
# Find these in the Supabase dashboard → Project Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
