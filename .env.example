# Supabase — copy this file to `.env.local` and fill in your project's values.
# Both are PUBLIC client keys (safe to ship): the anon key is protected by
# Row-Level Security. NEVER put the service_role key in here or anywhere the
# client can read it.
#
# Find these in the Supabase dashboard → Project Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cloudflare Turnstile — the bot check on the sign-in, registration and
# password-reset forms. This is the SITE key, which is public and ships in
# the bundle; the SECRET key goes into the Supabase dashboard only
# (Authentication → Attack Protection → CAPTCHA). Leave empty to run without
# a captcha, which is what local development does.
#
# Order matters when switching it on in production: deploy the client with
# this key FIRST, and only then enable the captcha in Supabase — the moment
# Supabase requires a token, every sign-in without one is refused.
VITE_TURNSTILE_SITE_KEY=
