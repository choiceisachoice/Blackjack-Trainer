# The production web server, run by Nixpacks on Dokploy.
#
# Nixpacks recognises a Vite app and serves `dist` with Caddy, using a
# Caddyfile of its own that it does not read from the repository. That file
# says `try_files {path} /index.html`: a request for `/learn` finds no *file*
# called `learn` and falls back to the app shell. Which was fine while every
# page was the same empty shell — and defeats the prerendered pages in
# `dist/learn/index.html`, `dist/de/index.html` and so on, which the build
# writes so that a crawler gets the page and not an empty div.
#
# `nixpacks.toml` points the start command at this file instead. It is the
# Nixpacks template with three changes: an absolute root, `{path}/index.html`
# in the lookup, and a cache header on the hashed assets — the one place
# Vite content-hashes, and therefore the only place `immutable` is safe.
#
# Rollback is deleting `nixpacks.toml`; Nixpacks then uses its own file again.

{
	admin off
	persist_config off
	auto_https off
	log {
		format json
	}
	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT:3000} {
	log {
		format json
	}

	root * /app/dist
	encode gzip

	# Vite content-hashes everything under /assets, so a returning visitor
	# need never ask about them again. Everything else keeps Caddy's default.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	file_server

	# A file, then a prerendered page in a directory, then the empty app
	# shell for the client-side routes (/app, /account, /login).
	try_files {path} {path}/index.html /shell.html
}
