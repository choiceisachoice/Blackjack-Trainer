# The production web server, run by Nixpacks on Dokploy.
#
# Nixpacks recognises a Vite app and serves `dist` with Caddy, using a
# Caddyfile of its own that it does not read from the repository. That file
# says `try_files {path} /index.html`: a request for `/learn` finds no *file*
# called `learn` and falls back to the app shell. Which was fine while every
# page was the same empty shell — and defeats the prerendered pages in
# `dist/learn/index.html`, `dist/de/index.html` and so on, which the build
# writes so that a crawler gets the page and not an empty div.
#
# `nixpacks.toml` points the start command at this file instead. It is the
# Nixpacks template with three changes: an absolute root, `{path}/index.html`
# in the lookup, and a cache header on the hashed assets — the one place
# Vite content-hashes, and therefore the only place `immutable` is safe.
#
# Rollback is deleting `nixpacks.toml`; Nixpacks then uses its own file again.

{
	admin off
	persist_config off
	auto_https off
	log {
		format json
	}
	servers {
		trusted_proxies static private_ranges
	}
}

# The security headers, as a snippet because two places need them: every
# ordinary response, and the 404 page in `handle_errors` at the bottom. That
# block runs outside the main route, and the `-Server` line makes this whole
# block deferred — applied only to responses written inside the route that
# set it — so an error page would otherwise go out with none of them.
(security_headers) {
	# Security headers, set here and not on the server.
	#
	# They were meant to come from a Traefik middleware pasted into Dokploy by
	# hand (`docs/traefik-security-headers.yml`), because at the time nothing
	# in this repository configured the web server. On 13 Nov 2026 the live
	# site answered with none of them: no HSTS, no framing protection, no
	# nosniff. A header configured on the server fails silently — no error, no
	# failed deploy — which is exactly how it went missing. This file is in the
	# image, so the headers are deployed with the code and reviewed with it.
	#
	# `frame-ancestors 'none'` and X-Frame-Options are the two that matter
	# most here: the pages start Stripe checkouts, and a page that can be
	# framed by another origin can be clicked through one.
	#
	# No `includeSubDomains` on HSTS: the DNS zone still has a wildcard record
	# pointing at an older host, and forcing HTTPS onto machines outside this
	# deployment would break something invisible from here.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		# The full policy, enforced since 18 Nov 2026.
		#
		# It ran report-only from 13 Nov, because a policy that is wrong about
		# one origin does not degrade — it blocks sign-in. Checked before the
		# switch, with a listener for `securitypolicyviolation` (the browser
		# console tools do not show these reports — the first check, read from
		# the console, proved nothing): signed out on the landing page, sign-in
		# and sign-up with the captcha, the theory hub and a chapter, the chart,
		# a translated page, pricing and contact; signed in on the plan, every
		# training mode, a dealt hand at the casino table, analytics, awards
		# and the account page. No report on any of them.
		#
		# To go back: rename this header to Content-Security-Policy-Report-Only,
		# drop `upgrade-insecure-requests` from it (browsers reject it there),
		# and restore `Content-Security-Policy "frame-ancestors 'none'"`.
		# A new third-party origin (a payment script, an embed, an analytics
		# host) has to be added here first, or it is silently blocked.
		Content-Security-Policy "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co; worker-src 'self' blob:; manifest-src 'self'; media-src 'self'; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"

		-Server
	}
}

:{$PORT:3000} {
	log {
		format json
	}

	root * /app/dist

	# zstd first, gzip for the rest. Caddy has no brotli of its own, and zstd
	# is what current Chrome, Edge and Firefox ask for; measured on this build,
	# JS and CSS come out ~19 % smaller than gzip. Safari still gets gzip.
	#
	# The list is Caddy's default minus `font/*`: woff2 is Brotli inside
	# already, and webp, jpg, png and mp3 are not on it either. Compressing
	# those spends CPU on every request to make them a few bytes larger.
	encode zstd gzip {
		match {
			header Content-Type text/*
			header Content-Type application/javascript*
			header Content-Type application/json*
			header Content-Type application/ld+json*
			header Content-Type application/manifest+json*
			header Content-Type application/xml*
			header Content-Type application/xhtml+xml*
			header Content-Type application/wasm*
			header Content-Type image/svg+xml*
			header Content-Type image/x-icon*
			header Content-Type image/vnd.microsoft.icon*
		}
	}

	# One host. Traefik in front routes www here as well, and until this
	# line the www address answered with a full copy of every page — two URLs
	# for one page, which a search engine has to resolve on its own and may
	# resolve the wrong way. The apex is the canonical host, so www redirects.
	@www host www.black-jack-training.com
	redir @www https://black-jack-training.com{uri} permanent

	# Vite content-hashes everything under /assets, so a returning visitor
	# need never ask about them again. Everything else keeps Caddy's default.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# The web app manifest, by its registered type. Caddy takes the type from
	# the operating system's table, which may not know `.webmanifest`; the file
	# would then go out as text/plain. Browsers read it regardless, but an
	# install check that looks at the header does not.
	@manifest path /manifest.webmanifest
	header @manifest Content-Type "application/manifest+json"

	# Everything else is asked about again on every visit. Without this line a
	# page carried only Last-Modified, and a browser may then keep it fresh on
	# its own guess (10 % of its age): Safari served the page from before a
	# deploy, with the old script names, and the QR welcome never ran, while a
	# private window showed the new one (10 Nov 2026). The ETag makes the
	# question cheap: an unchanged page answers 304 with no body.
	@pages not path /assets/* /fonts/* /cards/* /sounds/* /og-card.jpg
	header @pages Cache-Control "no-cache"

	# The fonts, the card faces, the table sounds and the link-preview image.
	# Not hashed — the file keeps its name when its content changes — so not
	# `immutable`: a week, then one revalidation in the background (the ETag
	# makes that a 304). A replaced card face can take up to a week to reach a
	# returning visitor; rename the file if it must arrive sooner. Before
	# 28 Nov 2026 these were `no-cache` and asked about on every page.
	@static path /fonts/* /cards/* /sounds/* /og-card.jpg
	header @static Cache-Control "public, max-age=604800, stale-while-revalidate=86400"

	# Security headers: the `(security_headers)` snippet above the site.
	import security_headers

	# The client-side routes get the empty app shell, with or without a
	# language prefix: the sign-in and password-reset forms, the trainer and
	# every screen under it (/app/speed, /app?checkout=success from Stripe),
	# the account and the admin numbers. Mirrors `routeFor` in
	# src/routes/pages.ts; a new client-side route has to be added here too,
	# or it answers 404 (still drawn by the app, but not indexed and not
	# linkable as a 200). The /dev screens exist only in development.
	@shell path_regexp shell ^(/(de|fr|it|es|pt|tr))?/(login|reset-password|account|admin/analytics|app(/.*)?)/?$
	handle @shell {
		rewrite * /shell.html
		file_server
	}

	# Everything else: a file, or a prerendered page in a directory. Nothing
	# else exists, and from 28 Nov 2026 it says so — until then every unknown
	# path answered 200 with the shell, which a search engine reads as a page
	# (a soft 404) and the app quietly redirected to the landing.
	handle {
		try_files {path} {path}/index.html
		file_server
	}

	# The 404 (and any other error) is the app shell with the error's status:
	# `file_server` keeps the status inside `handle_errors`. A visitor who
	# followed a broken link still lands somewhere — the app's router sends an
	# unknown path to the landing — while a crawler sees the 404.
	handle_errors {
		import security_headers
		header Cache-Control "no-cache"
		rewrite * /shell.html
		file_server
	}
}
