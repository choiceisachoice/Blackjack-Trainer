# The production web server, run by Nixpacks on Dokploy.
#
# Nixpacks recognises a Vite app and serves `dist` with Caddy, using a
# Caddyfile of its own that it does not read from the repository. That file
# says `try_files {path} /index.html`: a request for `/learn` finds no *file*
# called `learn` and falls back to the app shell. Which was fine while every
# page was the same empty shell — and defeats the prerendered pages in
# `dist/learn/index.html`, `dist/de/index.html` and so on, which the build
# writes so that a crawler gets the page and not an empty div.
#
# `nixpacks.toml` points the start command at this file instead. It is the
# Nixpacks template with three changes: an absolute root, `{path}/index.html`
# in the lookup, and a cache header on the hashed assets — the one place
# Vite content-hashes, and therefore the only place `immutable` is safe.
#
# Rollback is deleting `nixpacks.toml`; Nixpacks then uses its own file again.

{
	admin off
	persist_config off
	auto_https off
	log {
		format json
	}
	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT:3000} {
	log {
		format json
	}

	root * /app/dist
	encode gzip

	# One host. Traefik in front routes www here as well, and until this
	# line the www address answered with a full copy of every page — two URLs
	# for one page, which a search engine has to resolve on its own and may
	# resolve the wrong way. The apex is the canonical host, so www redirects.
	@www host www.black-jack-training.com
	redir @www https://black-jack-training.com{uri} permanent

	# Vite content-hashes everything under /assets, so a returning visitor
	# need never ask about them again. Everything else keeps Caddy's default.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Everything else is asked about again on every visit. Without this line a
	# page carried only Last-Modified, and a browser may then keep it fresh on
	# its own guess (10 % of its age): Safari served the page from before a
	# deploy, with the old script names, and the QR welcome never ran, while a
	# private window showed the new one (10 Nov 2026). The ETag makes the
	# question cheap: an unchanged page answers 304 with no body.
	@pages not path /assets/*
	header @pages Cache-Control "no-cache"

	# Security headers, set here and not on the server.
	#
	# They were meant to come from a Traefik middleware pasted into Dokploy by
	# hand (`docs/traefik-security-headers.yml`), because at the time nothing
	# in this repository configured the web server. On 13 Nov 2026 the live
	# site answered with none of them: no HSTS, no framing protection, no
	# nosniff. A header configured on the server fails silently — no error, no
	# failed deploy — which is exactly how it went missing. This file is in the
	# image, so the headers are deployed with the code and reviewed with it.
	#
	# `frame-ancestors 'none'` and X-Frame-Options are the two that matter
	# most here: the pages start Stripe checkouts, and a page that can be
	# framed by another origin can be clicked through one.
	#
	# No `includeSubDomains` on HSTS: the DNS zone still has a wildcard record
	# pointing at an older host, and forcing HTTPS onto machines outside this
	# deployment would break something invisible from here.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Content-Security-Policy "frame-ancestors 'none'"

		# The full policy, reporting only for now. It was written and checked
		# before the Turnstile captcha existed, and a policy that is wrong
		# about one origin does not degrade — it blocks sign-in. Report-only
		# lists every violation in the browser console and blocks nothing; once
		# the live pages (landing, sign-in with the captcha, the app, account)
		# load without a report, move this string into Content-Security-Policy
		# above and delete this line. `upgrade-insecure-requests` belongs to the
		# enforced policy only — browsers ignore it in a report-only one and say
		# so in the console of every page — so add it back when this moves up.
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co; worker-src 'self' blob:; manifest-src 'self'; media-src 'self'; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

		-Server
	}

	file_server

	# A file, then a prerendered page in a directory, then the empty app
	# shell for the client-side routes (/app, /account, /login).
	try_files {path} {path}/index.html /shell.html
}
